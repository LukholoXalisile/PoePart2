// Add this interface at bottom of class
@FunctionalInterface
interface Validator {
    boolean validate(String input);
}

// Add this method
private static String getValidatedInput(String prompt, Validator validator, String errorMsg) {
    while (true) {
        String input = JOptionPane.showInputDialog(prompt);
        if (input == null) return null;
        if (validator.validate(input)) return input;
        JOptionPane.showMessageDialog(null, errorMsg);
    }
}

// Replace sendMessages with this version
private static void sendMessages(int total) {
    for (int i = 1; i <= total; i++) {
        JOptionPane.showMessageDialog(null, "Enter details for Message " + i + " of " + total);
        
        String id = getValidatedInput("Enter Message ID (max 10 characters):", 
                                      s -> s!= null &&!s.isEmpty() && s.length() <= 10, 
                                      "ID must be 1-10 characters");
        if (id == null) continue;
        
        String cell = getValidatedInput("Enter Cell Number (starts with +27, max 13 digits):", 
                                        s -> s!= null && s.matches("\\+27\\d{1,11}"), 
                                        "Cell must start with +27 and be max 13 digits");
        if (cell == null) continue;
        
        String text = getValidatedInput("Enter Message Text:", 
                                        s -> s!= null &&!s.trim().isEmpty(), 
                                        "Message text cannot be empty");
        if (text == null) continue;
        
        Message msg = new Message(id, cell, text);
        if (msg.checkMessageID() && msg.checkRecipientCell() == 1) {
            String result = msg.sendMessage();
            JOptionPane.showMessageDialog(null, result);
        } else {
            JOptionPane.showMessageDialog(null, "Invalid details! Message " + i + " not sent.");
        }
    }
    
    int showJson = JOptionPane.showConfirmDialog(null, 
        "Would you like to view messages in JSON?", "JSON", JOptionPane.YES_NO_OPTION);
    if (showJson == JOptionPane.YES_OPTION) {
        Message.storeMessage();
    }
}
